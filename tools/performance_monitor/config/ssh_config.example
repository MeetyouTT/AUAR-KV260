# Merge this entry into %USERPROFILE%\.ssh\config.
# Replace the address, user and key path with your board's settings.
# Verify the board's host-key fingerprint before the first connection.
Host aura-kv260
    HostName 192.168.50.2
    User root
    IdentityFile ~/.ssh/aura_kv260_ed25519
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
