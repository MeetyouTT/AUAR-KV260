{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneState",
  "description": "SceneInterpreter 输出的最小场景状态（V1.0 §8.4；人2 冻结 schema，9/10 DEC-005）",
  "type": "object",
  "required": [
    "schema_version", "scene_seq", "captured_at_ms",
    "valid_until_ms", "camera_state", "people_count"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "scene_seq": { "type": "integer", "minimum": 0 },
    "captured_at_ms": { "type": "integer", "minimum": 0 },
    "valid_until_ms": { "type": "integer", "minimum": 0 },
    "camera_state": { "type": "string", "enum": ["online", "offline", "lost"] },
    "people_count": { "type": "integer", "minimum": 0 },
    "current_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track_id": { "type": "integer", "minimum": 0 },
        "position": { "type": "string", "enum": ["left", "center", "right"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_frame_id": { "type": "integer", "minimum": 0 }
      }
    },
    "recent_events": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["type", "track_id", "age_ms"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["person_enter", "person_exit", "target_change"] },
          "track_id": { "type": "integer" },
          "age_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "uncertainty": { "type": "array", "items": { "type": "string" } }
  }
}
