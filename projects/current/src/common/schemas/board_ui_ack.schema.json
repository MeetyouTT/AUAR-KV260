{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURA touchscreen acceptance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "board_boot_id",
    "service_epoch",
    "command_id",
    "ui_epoch",
    "ui_generation",
    "accepted",
    "detail"
  ],
  "properties": {
    "protocol_version": {
      "const": "aura-ui-1"
    },
    "board_boot_id": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1
    },
    "service_epoch": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1
    },
    "ui_epoch": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1
    },
    "ui_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accepted": {
      "type": "boolean"
    },
    "detail": {
      "type": "string",
      "maxLength": 160
    }
  }
}
