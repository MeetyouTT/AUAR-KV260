        <REGISTER NAME="rhs"><PROPERTY NAME="ADDRESS_OFFSET" VALUE="0x14"/><PROPERTY NAME="SIZE" VALUE="32"/><PROPERTY NAME="ACCESS" VALUE="read-write"/></REGISTER>
