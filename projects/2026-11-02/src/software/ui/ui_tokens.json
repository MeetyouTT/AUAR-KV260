{
  "schema_version": "1.2",
  "title": "UiTokens",
  "description": "UI 样式令牌：颜色/线宽/字号/间距/动画参数。PySide6 与 LVGL 版读取同一份令牌。字号为**板端 1024×600 档**（PC 1280×720 档已废弃，见 ui_layout_spec.json 说明）。",
  "colors": {
    "bg": "#F4EFF1",
    "panel_bg": "#FCFCF3",
    "panel_border": "#D8CDD3",
    "accent": "#873A4D",
    "accent_dark": "#303950",
    "warning": "#915600",
    "error": "#C62828",
    "success": "#2E7D32",
    "privacy_mask": "#E9E3E7",
    "text_primary": "#282C3C",
    "text_secondary": "#5E5B6A",
    "box": "#0B7FC4",
    "zone": "#E08600"
  },
  "line_widths": {
    "box": 2,
    "zone": 1,
    "status": 1
  },
  "fonts": {
    "title": 16,
    "label": 13,
    "small": 11,
    "dialogue": 14
  },
  "spacing": {
    "panel_padding": 8,
    "status_gap": 12
  },
  "animations": {
    "breath": { "period_ms": 3000, "scale": 0.06 },
    "attention": { "period_ms": 1500, "scale": 0.04 },
    "listen": { "period_ms": 800, "scale": 0.03 },
    "think": { "period_ms": 1200, "scale": 0.02 },
    "speak": { "period_ms": 500, "scale": 0.08 },
    "speak_neutral": { "period_ms": 600, "scale": 0.05 },
    "speak_low": { "period_ms": 700, "scale": 0.04 },
    "burst": { "period_ms": 920, "scale": 0.03 }
  },
  "transitions": {
    "state_ms": 150,
    "note": "状态切换交叉淡入时长（ms）；0 = 硬切。CANCELLED 等瞬时态回迁时用；burst 素材(920ms=22帧@24fps)时长为素材本身，无需额外淡入。"
  }
}
