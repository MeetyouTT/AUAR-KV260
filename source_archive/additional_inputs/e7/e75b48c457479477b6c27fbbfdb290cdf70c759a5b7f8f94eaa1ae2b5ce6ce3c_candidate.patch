+    def _observation_provenance(self, semantic, sources, *, maximum):
+        """Keep board-owned evidence classification outside model inference.
+
+        This labels the origin of historical records, not the truth of every
+        sentence in a mixed summary. It never repairs lost names, quantities,
+        negation, action status or source coverage. Original validators and
+        Store publication guards still decide whether the body can be deleted.
+        """
+        if (not any(source.get('protected', {}).get('evidence') == 'visual_observation'
+                    for source in sources) or OBSERVED.search(semantic['summary'])):
+            return semantic
+        # A source-label word can itself equal an explicit protected name.
+        # Validate the untouched model narrative first, so this label cannot
+        # accidentally repair any non-evidence protection. The final check
+        # still receives every original source and its full metadata.
+        validate_compaction_text(semantic['summary'], [dict(include_in_summary=True,
+            text=source.get('text', ''), metadata={key: value for key, value in
+                source.get('protected', {}).items() if key != 'evidence'}) for source in sources])
+        label = ('历史视觉观察摘要：' if all(source['source'] == 'camera_observed' for source in sources)
+                 else '混合历史记录（含视觉观察来源）：')
+        text = label + semantic['summary']
+        if len(text.encode('utf-8')) > maximum:
+            raise ContextLimitError('Source evidence label exceeds the bounded summary capacity')
+        return dict(semantic, summary=text)
+
