[Unit]
Description=AURA shared USB camera preview and YOLOX person adapter
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /home/root/aura-handsfree-dialogue-20261020/candidate-0c0a8ab46ec2/runtime/aura/board/vision/ui_camera_service.py --config /home/root/aura-handsfree-dialogue-20261020/candidate-0c0a8ab46ec2/camera_live_config/board_camera_ui.json
WorkingDirectory=/home/root/aura-handsfree-dialogue-20261020/candidate-0c0a8ab46ec2/runtime/aura
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
