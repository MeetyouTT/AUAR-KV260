+        if os.write(fd,raw)!=len(raw):raise OSError('Incomplete native checkpoint write')
+        os.fsync(fd)
+    finally:os.close(fd)
+    os.replace(str(temporary),str(path))
+    return {'path':str(path),'sha256':hashlib.sha256(raw).hexdigest()}
