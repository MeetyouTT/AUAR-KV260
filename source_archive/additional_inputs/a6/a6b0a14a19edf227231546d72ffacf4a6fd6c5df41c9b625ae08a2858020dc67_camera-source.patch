+        'scope':'final_quiescent_before_native_owner_close', 'seed':seed,
+        'source_unit_sha256':digest(source_unit_sha256,'source_unit_sha256'),
+        'auxiliary':{'active':0,'primary_waiting':0,'fenced':0,'pending_result_tokens':[0]*3,
