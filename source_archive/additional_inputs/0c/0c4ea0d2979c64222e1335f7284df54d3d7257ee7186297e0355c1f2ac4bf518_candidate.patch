+                self.ready = False
+                self.pending = None
+                self.inflight = 0
+            self.stopped.set()
+
+    def health(self):
+        with self.condition:
+            try:
+                runtime = self.embedder.health() if self.embedder is not None and callable(getattr(self.embedder,'health',None)) else None
+            except Exception as exc:
