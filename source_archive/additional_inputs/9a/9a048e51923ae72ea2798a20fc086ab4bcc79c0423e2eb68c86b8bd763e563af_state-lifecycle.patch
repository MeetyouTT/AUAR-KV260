+static void reset_base(struct basePLDesign *base)
+{
+    int j;
+    size_t index = base - base_designs;
+    free(base->slots);
+    memset(base, 0, sizeof(*base));
+    base->wd = -1;
+    for (j = 0; j < 10; j++)
+        base->accel_list[j].wd = -1;
+    base_removed[index] = 0;
+}
