+def encode_preview(pixels):
+    import cv2
+    import numpy as np
+    image = np.frombuffer(pixels, dtype=np.uint8).reshape(480, 640, 3)
+    ok, encoded = cv2.imencode('.jpg', image, [cv2.IMWRITE_JPEG_QUALITY, 72])
+    if not ok or encoded.nbytes > 256 * 1024:
+        raise ValueError('Preview encoding failed or exceeded size limit')
+    return encoded.tobytes()
