+"""Restore a hash-pinned same-boot protection snapshot before worker startup."""
+import copy
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import time
+import uuid
+
+
+def _integer(value, name, minimum=0):
+    if type(value) is not int or value < minimum:raise ValueError('Invalid protection integer: '+name)
+    return value
+
+
+def _finite(value, name, minimum=0.):
+    if type(value) not in (int,float) or not math.isfinite(value) or value < minimum:
+        raise ValueError('Invalid protection number: '+name)
+    return value
+
+
+def _consume_marker(marker, digest):
+    try:
+        fd=os.open(str(marker),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_CLOEXEC|os.O_NOFOLLOW,0o600)
+    except FileExistsError:
+        if marker.is_symlink() or marker.read_text().strip()!=digest:
+            raise ValueError('Protection handoff consumption marker differs')
+        return False
+    try:
+        stamp=(digest+'\n').encode()
+        if os.write(fd,stamp)!=len(stamp):raise OSError('Partial protection marker write')
+        os.fsync(fd)
+    finally:os.close(fd)
+    return True
+
+
+def _fresh_boot(schedule, seed, pin, path, boot_id):
+    if str(uuid.UUID(boot_id))!=boot_id or str(uuid.UUID(seed['boot']))!=seed['boot']:
+        raise ValueError('Canonical boot IDs required')
+    previous={kind:_integer(seed['schedule']['optional'][kind]['overruns'],kind+'.overruns')
+        for kind in ('yunet','sface')}
+    with schedule.condition:
+        if (schedule.jobs or schedule.primary_calls or schedule.active is not None or schedule._lease_sequence
+                or hasattr(schedule,'protection_handoff')):
+            raise ValueError('Fresh-boot state must precede all workers')
+        if schedule.yunet_recovery is None or schedule.sface_recovery is None:
+            raise ValueError('Independent recovery policies required')
+        first=_consume_marker(path.with_name(path.name+'.boot-'+boot_id+'.consumed'),pin['sha256'])
+        if not first:
+            for kind in ('yunet','sface'):
+                schedule.jobs[kind]={'calls':0,'skipped':0,'overruns':0,'budget_exceeded':0,
+                    'estimated_budget_ms':schedule.budget*1000.,'maximum_ms':0.,'disabled':True}
+                policy=schedule.yunet_recovery if kind=='yunet' else schedule.sface_recovery
+                policy.phase='LATCHED';policy.reason='uncheckpointed_same_boot_restart'
+        schedule.protection_handoff={'mode':'new_boot_fresh_process','source_boot':seed['boot'],
+            'current_boot':boot_id,'source_pid':seed['source_pid'],'seed_sha256':pin['sha256'],
+            'previous_snapshot_faults':previous,'first_use':first,
+            'counter_scope':'New kernel boot starts a new process/counter window; previous pinned snapshot remains archived, not replayed as current monotonic time'}
+        return copy.deepcopy(schedule.protection_handoff)
+
+
+def restore_protection(schedule, pin, *, boot_id, clock_ns=time.monotonic_ns, allow_new_boot=False):
+    """Pinned startup data is authority; incomplete/unconfirmed state never unlocks."""
+    if type(allow_new_boot) is not bool:raise ValueError('New-boot policy must be boolean')
+    if not isinstance(pin,dict) or set(pin)!={'path','sha256'}:
+        raise ValueError('Pinned protection handoff required')
+    path=Path(pin['path'])
+    if not path.is_absolute() or path.is_symlink() or path.resolve()!=path:
+        raise ValueError('Protection handoff path redirects')
+    raw=path.read_bytes()
+    if len(raw)>262144 or hashlib.sha256(raw).hexdigest()!=pin['sha256']:
+        raise ValueError('Protection handoff hash mismatch')
+    seed=json.loads(raw)
+    if seed['schema']!='aura-dpu-protection-handoff-1':raise ValueError('Protection handoff schema mismatch')
+    source_pid=_integer(seed['source_pid'],'source_pid',1)
+    _integer(seed['source_birth_ticks'],'source_birth_ticks',1)
+    captured=_integer(seed['captured_mono_ns'],'captured_mono_ns',1)
+    for name in ('source_unit_sha256','source_manifest_sha256'):
+        if not isinstance(seed[name],str) or len(seed[name])!=64 or any(c not in '0123456789abcdef' for c in seed[name]):
+            raise ValueError('Protection provenance hash missing')
+    if seed['boot']!=boot_id:
+        if not allow_new_boot:raise ValueError('Protection handoff boot mismatch')
+        return _fresh_boot(schedule,seed,pin,path,boot_id)
+    if captured>clock_ns():raise ValueError('Protection handoff is from the future')
+    old=seed['schedule']
+    if old['owner_fenced'] or old.get('owner_fault_reason'):
+        raise ValueError('Native owner completion is unconfirmed')
+    if old.get('active') is not None or old.get('waiting_primary')!=0:
+        raise ValueError('Protection snapshot must be taken while lease is idle')
+    if old['budget_ms']!=20. or old['guard_ms']!=5.:
+        raise ValueError('Protection budget changed')
+    jobs=copy.deepcopy(old['optional'])
