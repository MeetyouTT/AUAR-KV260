{
  "rules": {
    "directories": [
      ".pytest_cache",
      ".venv",
      ".verysync",
      "__pycache__",
      "venv"
    ],
    "suffixes": [
      ".pyc",
      ".pyo"
    ]
  },
  "excluded": [
    {
      "path": ".venv",
      "kind": "directory",
      "reason": "machine environment, cache or sync metadata"
    },
    {
      "path": "__pycache__",
      "kind": "directory",
      "reason": "machine environment, cache or sync metadata"
    }
  ]
}
