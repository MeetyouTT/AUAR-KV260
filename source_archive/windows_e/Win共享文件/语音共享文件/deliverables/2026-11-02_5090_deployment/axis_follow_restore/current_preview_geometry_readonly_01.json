    "/home/root/aura-board-business-20261030/production-5259eab11e42af13/runtime/aura/tools/board_camera_preview.py": {
      "sha256": "6e697c16f7ae264dff56b6b35f38da4b531ea13026b69a7c8bdbfb1960a6afcd",
      "source_lines": [
        {
          "line": 31,
          "text": "        pipeline=gst.parse_launch('appsrc name=input is-live=true format=time block=false max-bytes=921600 '"
        },
        {
          "line": 32,
          "text": "            'caps=\"video/x-raw,format=BGR,width=640,height=480,framerate=0/1,pixel-aspect-ratio=1/1\" ! '"
        },
        {
          "line": 33,
          "text": "            'queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 leaky=downstream ! '"
        },
        {
          "line": 177,
          "text": "                            if source.width>1920 or source.height>1080:raise ValueError('Preview dimensions exceeded')"
        },
        {
          "line": 178,
          "text": "                            if source.size!=(640,480):source=source.resize((640,480))"
        },
        {
          "line": 179,
          "text": "                            pixels=source.convert('RGB').tobytes('raw','BGR')"
        }
      ]
    },
    "/home/root/aura-native-live-20261024/candidates/native-r4-metrics-fix/aura/board/vision/local_preview.py": {
      "sha256": "f40212f3ebe7645cb7b55ecc9846882ec7d02c38a6a2703b98f934d7703d8f11",
      "source_lines": [
        {
          "line": 14,
          "text": "PREFIX = struct.Struct('!8sH')"
        },
        {
          "line": 15,
          "text": "PIXELS = 640*480*3"
        },
        {
          "line": 16,
          "text": "MAX_HEADER = 1024"
        },
        {
          "line": 49,
          "text": "    def publish(self, fid, stamp, pixels):"
        },
        {
          "line": 50,
          "text": "        if len(pixels)!=PIXELS:raise ValueError('Expected contiguous 640x480 BGR')"
        },
        {
          "line": 51,
          "text": "        header=json.dumps(dict(self.owner,frame_id=fid,captured_mono_ms=stamp),separators=(',',':')).encode()"
        }
      ]
    }
