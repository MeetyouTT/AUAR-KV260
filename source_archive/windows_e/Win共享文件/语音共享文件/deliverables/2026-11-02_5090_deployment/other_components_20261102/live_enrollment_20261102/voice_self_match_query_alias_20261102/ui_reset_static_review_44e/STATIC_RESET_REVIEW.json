    },
    {
      "case": "VOICEFIRST_30S_SILENCE",
      "chain": "VoiceFirst._monitor_tick -> _finish_session(CONVERSATION_SILENCE) -> Recording.cancel",
      "gate": "monitor_owned/monitor_entered, capture still RECORDING, elapsed listen_started>=30s and speech_activeFalse"
    },
    {
      "case": "AUTOMATIC_NEW_AUDIO_SESSION",
      "chain": "VoiceFirst._monitor_tick(!monitor_owned) -> _select_listening_conversation -> Jobs.select_conversation -> reset_enrollment",
      "gate": "After session cooldown with feedback ready and idle; second reset may follow the silence/service cleanup"
    },
    {
      "case": "SERVICE_OR_NATIVE_NOT_READY",
      "chain": "production_listening.monitor_tick -> _finish_session(SERVICE_NOT_READY) -> Recording.cancel",
      "gate": "Owned listener and runtime not started/closed or pair.ready_nowFalse"
    },
    {
      "case": "EXPLICIT_CONVERSATION_OR_PROFILE_CHANGE",
      "chain": "Jobs.select_conversation/select_profile -> reset_enrollment",
      "gate": "Original idle selection checks; changes actor/session scope"
    },
    {
      "case": "STAGE_RENDER_FAULT_OR_PAIR_FAILURE",
