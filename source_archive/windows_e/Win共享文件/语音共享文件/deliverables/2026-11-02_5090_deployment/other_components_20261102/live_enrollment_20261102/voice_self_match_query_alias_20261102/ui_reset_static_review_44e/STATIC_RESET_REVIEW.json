  "normal_paths": [
    {
      "case": "CAPTURE_ARM",
      "chain": "VoiceFirst._listen -> HandsFree._listen -> RecordingController._listen -> Jobs.cancel/capture_started",
      "resets_enrollment": false,
      "note": "Jobs.cancel invalidates generation and playback; it does not call reset_enrollment"
    },
    {
      "case": "ACTUAL_SPEECH_START",
      "chain": "AutomaticCapture VAD transition -> HandsFree._speech_started -> Jobs.capture_started",
      "resets_enrollment": false,
      "note": "Refreshes capture owner from RAM; invalid source stays unavailable"
    },
    {
      "case": "STREAM_START",
      "chain": "Presentation.channel_event -> NativeStreaming.channel_event -> Streaming.channel_event(start) -> Realtime.begin_dialogue -> visual.cancel",
      "resets_enrollment": false,
      "note": "NativeStreaming/Streaming/Realtime cancel chain belongs to visual controller, not recording controller"
    },
    {
      "case": "NORMAL_NATIVE_INVALIDATE",
      "chain": "visual.cancel -> portrait_offload.invalidate -> StrictLocalPortrait/LocalPortrait.invalidate",
      "resets_enrollment": false,
      "note": "Invalidates old numeric visual generation; does not fail pair or clear ready"
    },
    {
      "case": "FULL_PLAYBACK_COMPLETE",
      "chain": "Streaming.tick -> completed_streams -> IDLE/stream=None -> Recording.tick -> Jobs.acknowledge",
      "resets_enrollment": false,
      "note": "Full receipt goes to original ACK action worker"
    },
    {
      "case": "ACK_SUCCESS_REARM",
      "chain": "Jobs._perform_action(ack) committedTrue -> Recording._auto_tick -> _listen after0.5s settle",
      "resets_enrollment": false,
      "note": "No select_conversation on ordinary same-session rearm"
    },
    {
      "case": "PRESENTATION_RETIRE",
      "chain": "recording.tick wrapper -> Presentation.retire_consumed",
      "resets_enrollment": false,
      "note": "Only retires consumed display/log/utterance references after original idle gates; no cancel or ACK"
    }
  ],
  "reset_paths": [
    {
      "case": "EXPLICIT_CANCEL_PAUSE_STOP_OR_CLOSE",
      "chain": "Recording.cancel -> Jobs.cancel -> Jobs.reset_enrollment -> LIR.reset -> business.reset",
