  "candidate_summary": "Original client/systemd barriers around original wide/camera/GUI; original ID_STOP_ONLY; truthful selected-source rebinding; add-only installation and exact-byte rollback. No auto reference/center/follow.",
  "blocking_findings": [
    {
      "id": "B01_RELEVANT_QUEUED_PLATFORM_JOBS",
      "file": "candidate/boot_recovery.py",
      "sha256": "15e4f53f981603dff3d10bb1c53272c479a9b97d557f539f8f9a31ffa6b601d7",
      "lines": [
        [
          254,
          287
        ],
        [
          289,
          294
        ]
      ],
      "finding": "quiet() ignores relevant queued DFX jobs with no current process; it does not inspect any job queue if camera/GUI Job fields are empty. daemon_owner() accepts pending lifecycle Job.",
      "evidence": "validation/BOOT_RUNTIME_JOB_NEGATIVES_15e4.json",
      "minimal_fix": "Always inspect the bounded relevant platform job set at advancing boundaries, permit only exact owned ordered-start/continuation jobs, and require daemon Job empty; unknown/pending -> HOLD or observe the same durable attempt, never resubmit."
    },
    {
      "id": "B02_CAMERA_EXITING_OR_QUIESCED_USED_FOR_BINDING",
      "file": "candidate/boot_recovery.py",
      "sha256": "15e4f53f981603dff3d10bb1c53272c479a9b97d557f539f8f9a31ffa6b601d7",
      "lines": [
        [
          505,
          529
        ],
        [
          536,
          540
        ],
        [
          579,
          586
        ]
      ],
      "finding": "camera_samples() only rejects ActiveState=failed. Actual method AST accepts deactivating/stop-sigterm/Job=123 with advancing frames, and accepts Native quiesced=true. bind_camera then uses this owner to prepare source changes without a camera lifecycle recheck.",
      "evidence": "validation/BOOT_CAMERA_LIFECYCLE_NEGATIVES.json",
      "minimal_fix": "Require exact active/running/no-job/no unexpected ControlPID and native quiesced=false, plus unchanged PID/birth/cmd. Recheck the lifecycle immediately before binding CAS and before READY. Pending/exit/quiescence must not become a binding owner."
    },
    {
      "id": "B03_ACTIVE_LEDGER_EXPECTED_BYTES_DRIFT",
      "file": "candidate/boot_recovery.py",
      "sha256": "15e4f53f981603dff3d10bb1c53272c479a9b97d557f539f8f9a31ffa6b601d7",
      "lines": [
        [
          572,
          583
        ],
        [
          591,
          596
        ]
      ],
      "finding": "Intent captures prior_active_raw, but final replace_known uses a newly read active_path value as expected. A newer source-consistent ledger can be overwritten despite differing from the sealed intent.",
      "evidence": "gtk/BOOT_ACTIVE_LEDGER_CAS_NEGATIVE_CURRENT.json",
      "minimal_fix": "Bind initial ledger bytes and existence; require unchanged state before the first UI/startup write and use the same captured bytes for final CAS. Originally absent requires continued absence plus O_EXCL; appeared/disappeared/changed -> HOLD."
    }
  ],
