  "MiniMaxH3ReferenceToVideo": {
    "api_node": false,
    "category": "model/conditioning/minimax",
    "deprecated": false,
    "description": "<Picture i> / <Video k> / <Audio j> reference conditioning for MiniMax H3. Use the same tags when prompting.",
    "dev_only": false,
    "display_name": "MiniMax H3 Reference to Video",
    "essentials_category": null,
    "experimental": false,
    "has_intermediate_output": false,
    "input": {
      "optional": {
        "audio_vae": [
          "VAE",
          {
            "tooltip": "Audio VAE. Without it reference audio only conditions the text encoder."
          }
        ],
        "ref_audios": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_audio": [
                    "AUDIO",
                    {
                      "tooltip": "Standalone reference audio"
                    }
                  ]
                }
              },
              "max": 3,
              "min": 0,
              "prefix": "ref_audio_"
            }
          }
        ],
        "ref_images": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_image": [
                    "IMAGE",
                    {
                      "tooltip": "Reference image (downscaled to 2048 short edge if larger, never upscaled)"
                    }
                  ]
                }
              },
              "max": 9,
              "min": 0,
              "prefix": "ref_image_"
            }
          }
        ],
        "ref_video_audios": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_video_audio": [
                    "AUDIO",
                    {
                      "tooltip": "Soundtrack of the same-numbered reference video"
                    }
                  ]
                }
              },
              "max": 3,
              "min": 0,
              "prefix": "ref_video_audio_"
            }
          }
        ],
        "ref_videos": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_video": [
                    "IMAGE",
                    {
                      "tooltip": "Reference video frames at 24 fps (2-15s)"
                    }
                  ]
                }
              },
              "max": 3,
              "min": 0,
              "prefix": "ref_video_"
            }
          }
        ],
        "vae": [
          "VAE",
          {
            "tooltip": "Video VAE. Without it reference images/videos only condition the text encoder."
          }
        ]
      },
      "required": {
        "clip": [
          "CLIP",
          {}
        ],
        "height": [
          "INT",
          {
            "default": 768,
            "max": 16384,
            "min": 32,
            "step": 32
          }
        ],
        "length": [
          "INT",
          {
            "default": 124,
            "max": 3600,
            "min": 5,
            "step": 17,
            "tooltip": "Frame count at 24 fps, (124 = ~5s, trained range is ~124-362)"
          }
        ],
        "prompt": [
          "STRING",
          {
            "dynamicPrompts": true,
            "multiline": true
          }
        ],
        "ref_image_size": [
          "COMBO",
          {
            "default": "match",
            "multiselect": false,
            "options": [
              "match",
              "max"
            ],
            "tooltip": "Reference image sizing. 'match' scales each ref (down only, keeping aspect) to the generation's pixel area; 'max' uses the reference pipeline's 2048px short edge for best identity fidelity. Reference tokens ride through every sampling step, so 'max' can be several times slower."
          }
        ],
        "width": [
          "INT",
          {
            "default": 1344,
            "max": 16384,
            "min": 32,
            "step": 32
          }
        ]
      }
    },
    "input_order": {
      "optional": [
        "vae",
        "audio_vae",
        "ref_images",
        "ref_videos",
        "ref_video_audios",
        "ref_audios"
      ],
      "required": [
        "clip",
        "prompt",
        "width",
        "height",
        "length",
        "ref_image_size"
      ]
    },
    "is_input_list": false,
    "name": "MiniMaxH3ReferenceToVideo",
    "output": [
      "CONDITIONING",
      "LATENT"
    ],
    "output_is_list": [
      false,
      false
    ],
    "output_matchtypes": null,
    "output_name": [
      "positive",
      "LATENT"
    ],
    "output_node": false,
    "output_tooltips": [
      null,
      null
    ],
    "price_badge": null,
    "python_module": "comfy_extras.nodes_minimax_h3",
    "search_aliases": null
  }
}