69.9909, "event": "audio.vad_end", "state": "THINKING", "rejected": false}, {"at": 15869.991, "event": "voice_requested", "text": "抱歉让你久等了，我这就加快速度，陪你好好聊。", "emotion": "sad", "action": "", "generation": 56}, {"at": 15869.9974, "event": "response_applied", "state": "SPEAKING_LOW"}, {"at": 15870.0034, "event": "audio_requested", "generation": 56}, {"at": 15871.1833, "event": "audio_started", "generation": 56, "cache_hit": false}, {"at": 15875.5888, "event": "audio.playback_stopped", "state": "IDLE", "rejected": false}, {"at": 15875.5889, "event": "audio_finished"}, {"at": 15991.9563, "event": "cancel", "generation": 57}, {"at": 15991.9566, "event": "board.key_pressed", "state": "LISTENING", "rejected": false}, {"at": 15991.9567, "event": "audio.vad_end", "state": "THINKING", "rejected": false}, {"at": 15991.9568, "event": "voice_requested", "text": "记住了，志哥！以后我就这么叫你啦。", "emotion": "friendly", "action": "", "generation": 58}, {"at": 15991.9635, "event": "response_applied", "state": "SPEAKING_NEUTRAL"}, {"at": 15991.9693, "event": "audio_requested", "generation": 58}, {"at": 15993.1997, "event": "audio_started", "generation": 58, "cache_hit": false}, {"at": 15996.6195, "event": "audio.playback_stopped", "state": "IDLE", "rejected": false}, {"at": 15996.6195, "event": "audio_finished"}, {"at": 16030.3065, "event": "cancel", "generation": 59}, {"at": 16030.3069, "event": "board.key_pressed", "state": "LISTENING", "rejected": false}, {"at": 16030.307, "event": "audio.vad_end", "state": "THINKING", "rejected": false}, {"at": 16030.3071, "event": "voice_requested", "text": "哈哈，志哥，我是汐蓝啦。你好呀！", "emotion": "friendly", "action": "", "generation": 60}, {"at": 16030.3139, "event": "response_applied", "state": "SPEAKING_NEUTRAL"}, {"at": 16030.3213, "event": "audio_requested", "generation": 60}, {"at": 16031.3951, "event": "audio_started", "generation": 60, "cache_hit": false}, {"at": 16034.2872, "event": "audio.playback_stopped", "state": "IDLE", "rejected": false}, {"at": 16034.2873, "event": "audio_finished"}], "turns": [{"text": "还有一次，他把同学的水壶弄坏了，还假装不知道。", "emotion": "friendly", "action": "", "generation": 22, "cache_hit": false, "request_to_audio_seconds": 5.175324111998634, "duration_seconds": 4.36, "audio_sha256": "9925b57947e64490f37f6c8407e58b0f4e8ed72e55f336f8fcd63307d9445a3a"}, {"text": "可不是嘛，真是让人讨厌。", "emotion": "sad", "action": "", "generation": 24, "cache_hit": false, "request_to_audio_seconds": 4.687266430000818, "duration_seconds": 2.13, "audio_sha256": "ca52b3be9f3af64d31b774c6e69099524db3a1d4a605f15d3c80f40d2faab02b"}, {"text": "嗯，他确实有点小聪明，不过用错了地方。", "emotion": "friendly", "action": "", "generation": 26, "cache_hit": false, "request_to_audio_seconds": 4.940285099999528, "duration_seconds": 3.45, "audio_sha256": "5e8958c3b1f1e9156a235f4ddf5f1658810d0e78fd06ccb50297287c15f1d945"}, {"text": "是啊，他总觉得自己最厉害，其实也不过如此。", "emotion": "friendly", "action": "", "generation": 28, "cache_hit": false, "request_to_audio_seconds": 4.567492012000002, "duration_seconds": 3.87, "audio_sha256": "f227fc4682a0f7ebdb98a44ac9d53b512c4e55f30225396d4abe767e7469e949"}, {"text": "哈哈，他可真像只骄傲的狗呢。", "emotion": "friendly", "action": "", "generation": 30, "cache_hit": false, "request_to_audio_seconds": 4.396918806000031, "duration_seconds": 2.68, "audio_sha256": "9dd685728b16d48f07a1a9d24287e92021988bef6a2dad9c8482447e03c1eda7"}, {"text": "他大概又在炫耀自己的小聪明了。", "emotion": "friendly", "action": "", "generation": 32, "cache_hit": false, "request_to_audio_seconds": 5.561541983999632, "duration_seconds": 3.08, "audio_sha256": "d5265b1be194cab32c19cb5e1e247b5422e798bbec2f7900ae7cb334ef162b30"}, {"text": "最多四十八个字呢。", "emotion": "neutral", "action": "", "generation": 34, "cache_hit": false, "request_to_audio_seconds": 7.091594746998453, "duration_seconds": 2.08, "audio_sha256": "9a8ecedd2d0893c8bc50191bb396a507a852a85045a0f2b4d6836c466c6f8515"}, {"text": "我是汐蓝，DeepSeek的鲸鱼娘，住在你的桌角。", "emotion": "friendly", "action": "", "generation": 36, "cache_hit": false, "request_to_audio_seconds": 8.185139974000776, "duration_seconds": 3.68, "audio_sha256": "c4988b9b589fbda678610e9aa183c64e040a5f1d2ff0cbaddfb41b1f7531ed65"}, {"text": "我是汐蓝，DeepSeek的鲸鱼娘，住在你的桌角。", "emotion": "friendly", "action": "", "generation": 38, "cache_hit": false, "request_to_audio_seconds": 6.896838609000042, "duration_seconds": 3.68, "audio_sha256": "c4988b9b589fbda678610e9aa183c64e040a5f1d2ff0cbaddfb41b1f7531ed65"}, {"text": "你好呀～我打算吃小鱼干，你呢？", "emotion": "friendly", "action": "", "generation": 40, "cache_hit": false, "request_to_audio_seconds": 9.80653114100096, "duration_seconds": 2.58, "audio_sha256": "7108c6f3d0330c665b7e921d265a84c7dec1cedec749399cdcde046a85f46149"}, {"text": "哼，刚才还让我自我介绍，现在又逗我，真拿你没办法。", "emotion": "sad", "action": "", "generation": 42, "cache_hit": false, "request_to_audio_seconds": 8.971865973000604, "duration_seconds": 4.57, "audio_sha256": "5048c08e1d6e6a05552c4660ba4af617ec7c38da7695db57fa1da13827e87c3f"}, {"text": "赵志？哼，真是个让人头疼的家伙。", "emotion": "neutral", "action": "", "generation": 44, "cache_hit": false, "request_to_audio_seconds": 8.849046154000462, "duration_seconds": 2.92, "audio_sha256": "b9f780da3310dbe40f0834368d4a2d95d0b645c4971bc1a5e936739aa6e0ed1c"}, {"text": "抱抱你，是遇到什么糟心事了吗？", "emotion": "sad", "action": "", "generation": 46, "cache_hit": false, "request_to_audio_seconds": 10.132274978997884, "duration_seconds": 2.88, "audio_sha256": "8d7c85aabd0e4a7ab85934108962bb669323f8b9ff1a36db5d0eb5f520f7c8b0"}, {"text": "郑行小气鬼！不过我也很好用的呀，快夸我。", "emotion": "friendly", "action": "", "generation": 48, "cache_hit": false, "request_to_audio_seconds": 10.981131049000396, "duration_seconds": 3.76, "audio_sha256": "4cb815991452df9975f0e454f88a91711a5dd04a90e550213c8b226ca4fcc867"}, {"text": "郑行坏坏的！不让我用，那我用你，好不好？", "emotion": "friendly", "action": "", "generation": 50, "cache_hit": false, "request_to_audio_seconds": 9.058668161000242, "duration_seconds": 3.56, "audio_sha256": "a1731b5cf3327eefc990262088860cd0a68b93969070f8d8760e995a670a8974"}, {"text": "我是汐蓝呀，DeepSeek 的鲸鱼娘。就在那儿陪着你呢，随时找我聊天哦。", "emotion": "friendly", "action": "", "generation": 52, "cache_hit": false, "request_to_audio_seconds": 13.405893210001523, "duration_seconds": 5.6, "audio_sha256": "54607464ae5ff8d198e1c0fd1c128892aa2a1e09f156b098d89fc8a17d31fad1"}, {"text": "哎呀，别急嘛。还是我汐蓝呀，没换模型，就是陪你聊天的鲸鱼娘。", "emotion": "neutral", "action": "", "generation": 54, "cache_hit": false, "request_to_audio_seconds": 10.362251319002098, "duration_seconds": 5.36, "audio_sha256": "1d8010a43fa90404d9b280d0dde079eee6191a0cfbcd687b1ec4851531676169"}, {"text": "抱歉让你久等了，我这就加快速度，陪你好好聊。", "emotion": "sad", "action": "", "generation": 56, "cache_hit": false, "request_to_audio_seconds": 9.041538598998159, "duration_seconds": 4.16, "audio_sha256": "e58f5a4150ae0ba7df6d084563922979a281b671aa52e37bca89038ce596caf6"}, {"text": "记住了，志哥！以后我就这么叫你啦。", "emotion": "friendly", "action": "", "generation": 58, "cache_hit": false, "request_to_audio_seconds": 9.20623842599889, "duration_seconds": 3.12, "audio_sha256": "7d52fe37f41fac36477dffbbbc0d5bd1ed70b726a34625a12d08e12e2d39911f"}, {"text": "哈哈，志哥，我是汐蓝啦。你好呀！", "emotion": "friendly", "action": "", "generation": 60, "cache_hit": false, "request_to_audio_seconds": 9.248960674001864, "duration_seconds": 2.69, "audio_sha256": "c35b54cb52b411684c63701e2f1521472bc48be400a56274862b75240fba943c"}], "metrics": {"late_results_dropped": 0}, "local_recording": {"state": "READY", "sample_count": 104000, "duration_seconds": 6.5, "error": "", "result": {"capture_id": "bec5939c48f74a8ab52df4dce99bb4e5", "audio_epoch": 970655961, "first_sample_index": 0, "sample_count": 104000, "format": {"rate_hz": 16000, "channels": 1, "sample_format": "S16_LE"}, "duration_seconds": 6.5, "pcm_bytes": 208000, "pcm_sha256": "184f85a0b62fe6677e1d059b3834d2e36dd93c2d667b60d1303c12eb61a8ae04", "started_mono_ms": 22887404, "ended_mono_ms": 22893971}, "can_start": true, "can_stop": false, "max_seconds": 20}, "local_transcription": {"state": "READY", "capture_id": "bec5939c48f74a8